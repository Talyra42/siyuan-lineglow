{
  "name": "siyuan-lineglow",
  "type": "module",
  "version": "1.1.0",
  "description": "Highlight the specified lines of a code block in SiYuan, using the VitePress style line range syntax",
  "author": "Talyra42",
  "license": "MIT",
  "homepage": "",
  "repository": "https://github.com/Talyra42/siyuan-lineglow",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "node ./release.js",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.8.1",
    "@types/node": "^20.2.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "fast-glob": "^3.2.12",
    "jsdom": "^30.1.2",
    "minimist": "^1.2.8",
    "prettier": "^3.9.9",
    "sass": "^1.62.1",
    "siyuan": "^1.2.9",
    "typescript": "^5.0.4",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^3.0.5"
  }
}
